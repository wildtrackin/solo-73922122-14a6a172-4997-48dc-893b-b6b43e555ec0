# 复制为 .env 后按需修改；docker compose 默认读取同目录 .env
# ===== 源库 =====
POSTGRES_DB=lab
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab_source_pw
SOURCE_DB_PORT=5432

# ===== 独立日志库 =====
LOG_DB_NAME=changelog
LOG_DB_USER=logger
LOG_DB_PASSWORD=log_pw
LOG_DB_PORT=5433

# ===== 复制槽 / API =====
SLOT_NAME=lab_results_slot
API_PORT=8000

# 崩溃演示：1=采集器在“日志库已提交、源位置未确认”窗口退出一次
CRASH_AFTER_PERSIST=0
